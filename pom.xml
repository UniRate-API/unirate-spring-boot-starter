<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.unirateapi</groupId>
    <artifactId>unirate-spring-boot-starter</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>UniRate Spring Boot Starter</name>
    <description>Spring Boot auto-configuration starter for the UniRate API — free currency exchange rates, historical data, and VAT rates.</description>
    <url>https://unirateapi.com</url>

    <organization>
        <name>UniRate</name>
        <url>https://unirateapi.com</url>
    </organization>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Unirate Team</name>
            <url>https://unirateapi.com</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/UniRate-API/unirate-spring-boot-starter.git</connection>
        <developerConnection>scm:git:ssh://github.com:UniRate-API/unirate-spring-boot-starter.git</developerConnection>
        <url>https://github.com/UniRate-API/unirate-spring-boot-starter/tree/main</url>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.4.1</spring-boot.version>
        <unirate.version>0.1.1</unirate.version>
    </properties>

    <!--
      Import the Spring Boot BOM so every Spring-managed dependency (including
      the test stack) resolves at one coherent, pinned version. The only
      dependency we version by hand is the UniRate client, which is not in the
      BOM.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The published, Maven-Central UniRate Java client (pulls only jackson-databind). -->
        <dependency>
            <groupId>com.unirateapi</groupId>
            <artifactId>unirate-api</artifactId>
            <version>${unirate.version}</version>
        </dependency>

        <!--
          Auto-configuration APIs. 'provided' because every Spring Boot
          application already carries spring-boot-autoconfigure on its
          classpath; we must NOT drag our pinned Spring version onto the
          consumer's tree (nearest-wins would otherwise fight their BOM).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Generates IDE metadata for the `unirate.*` properties. Compile-only, never shipped. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>

        <!-- Test stack (JUnit 5 + AssertJ + spring-test), BOM-versioned. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <doclint>none</doclint>
                    <failOnError>false</failOnError>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Activated only on release (CI tag build): signs all artifacts with GPG
          and publishes the bundle to Maven Central via the Sonatype Central
          Portal. Day-to-day `mvn test` never needs a signing key or a token.
          Mirrors the pipeline proven on unirate-api-java (gotcha #35: plugin
          0.11.0 so the status-poll finishes green).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
